# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Puerto del servidor
PORT=3000

# Unsplash (fotos automáticas cuando no se suben imágenes placeholder).
# Crea una app en https://unsplash.com/developers y copia el "Access Key".
# Sin esta clave, los decks sin imágenes subidas se generan solo con texto/tarjetas.
UNSPLASH_ACCESS_KEY=
# Retrato del avatar-tutor cuando no se sube ninguno (búsqueda en Unsplash, portrait).
# Por defecto "friendly professional portrait person"; "off" desactiva el avatar automático.
# UNSPLASH_AVATAR_QUERY=friendly professional portrait person

# ElevenLabs (texto a voz). https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voz por defecto. Debe ser una voz EN ESPAÑOL de tu cuenta: muchas voces "premade"
# (Sarah, George, Daniel…) son inglesas y narran el castellano con acento.
# Lístalas con: curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=CdAqYBLnsNjmTqYgD5Ha   # Dani — es/peninsular
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voces del selector de la UI (JSON). La primera es la que se preselecciona.
# Si se omite, se usa solo ELEVENLABS_VOICE_ID. Los ids deben existir en tu cuenta.
# ELEVENLABS_VOICES=[{"id":"CdAqYBLnsNjmTqYgD5Ha","label":"Dani — ES · natural"},{"id":"2Sy5ix8lbjfxqVPGtlt7","label":"Fa — CL · docente"},{"id":"SDVJaMLoJa7wc3s2sn7d","label":"Lydia — ES · educativa"}]
