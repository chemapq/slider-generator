# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Puerto del servidor
PORT=3000

# Unsplash (fotos automáticas cuando no se suben imágenes placeholder).
# Crea una app en https://unsplash.com/developers y copia el "Access Key".
# Sin esta clave, los decks sin imágenes subidas se generan solo con texto/tarjetas.
UNSPLASH_ACCESS_KEY=
# Retrato del avatar-tutor cuando no se sube ninguno (búsqueda en Unsplash, portrait).
# Por defecto "friendly professional portrait person"; "off" desactiva el avatar automático.
# UNSPLASH_AVATAR_QUERY=friendly professional portrait person

# Acceso por contraseña. VACÍA O SIN DEFINIR = APP ABIERTA, sin login (uso en local).
# Al ponerle valor, TODO queda tras un formulario: la app, los decks y las /api/*.
APP_PASSWORD=ako89eKc2ZM6
# Secreto para firmar la cookie de sesión. Si se omite se deriva de APP_PASSWORD, así que
# cambiar la contraseña cierra las sesiones abiertas. Ponlo explícito si sirves varias
# instancias detrás del mismo dominio y quieres controlarlo por tu cuenta.
# SESSION_SECRET=
# Duración de la sesión en horas (por defecto 12).
# SESSION_TTL_HOURS=12

# ElevenLabs (texto a voz). https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voz por defecto. Debe ser una voz EN ESPAÑOL de tu cuenta: muchas voces "premade"
# (Sarah, George, Daniel…) son inglesas y narran el castellano con acento.
# Lístalas con: curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=CdAqYBLnsNjmTqYgD5Ha   # Dani — es/peninsular
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voces del selector de la UI (JSON). La primera es la que se preselecciona.
# Si se omite, se usa solo ELEVENLABS_VOICE_ID. Los ids deben existir en tu cuenta.
# `avatarId` (opcional) empareja la voz con la cara de HeyGen que la locuta: elegir esa voz
# da SIEMPRE ese presentador, en el vídeo de intro y en la foto del cierre. Es un LOOK id
# (GET /v3/avatars/looks/{id}), no el id del grupo. Lístalos con: npm run heygen:avatars
# Elige looks de PLANO CORTO ("Upper Body"/"expressive"): el tutor se recorta en círculo y
# un plano entero deja la cara diminuta. Y respeta el género de la voz, o el lip-sync canta.
# ELEVENLABS_VOICES=[{"id":"CdAqYBLnsNjmTqYgD5Ha","label":"Dani — ES · natural","avatarId":"Raul_expressive_2024112501"},{"id":"SDVJaMLoJa7wc3s2sn7d","label":"Lydia — ES · educativa","avatarId":"Judita_expressive_2024112701"}]

# HeyGen (avatar en vídeo con lip-sync para la INTRO). https://app.heygen.com → Settings → API
HEYGEN_API_KEY=
# Motor de render. HeyGen usa avatar_iv si no se declara, y eso tiene dos efectos caros:
#   · avatar_iv cuesta $4/min; avatar_iii cuesta $1/min (mismo vídeo, 4x menos factura)
#   · muchos looks NO admiten avatar_iv → "does not support Avatar IV video generation".
#     No es que el avatar sea inválido: es que no soporta ESE motor.
# Cada look declara los que admite en `supported_api_engines`; npm run heygen:avatars lo
# comprueba gratis (sin generar vídeo) para todo el mapeo de voces.
HEYGEN_ENGINE=avatar_iii
# Presentador por defecto, para voces sin `avatarId` en ELEVENLABS_VOICES. También un look id.
HEYGEN_AVATAR_ID=
# HEYGEN_POLL_TIMEOUT_MS=600000
# Modo de pruebas: recorta el audio enviado a HeyGen a ~N segundos para no gastar
# créditos generando vídeos largos mientras se prueba la integración. Súbelo o
# bórralo (0 = sin recorte) cuando quieras vídeos con la duración real.
HEYGEN_TEST_MAX_SEC=8
