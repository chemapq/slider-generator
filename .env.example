# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Puerto del servidor
PORT=3000

# ElevenLabs (texto a voz). https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # id de la voz por defecto (es-ES/es-LA)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voces disponibles en el selector de la UI (JSON). Si se omite, se usa ELEVENLABS_VOICE_ID.
# ELEVENLABS_VOICES=[{"id":"<voiceId>","label":"Lucía (es-ES)"},{"id":"<voiceId2>","label":"Mateo (es-LA)"}]
