{
  "name": "slider-generator",
  "version": "0.1.0",
  "description": "Genera slides HTML (reveal.js) a partir de PDFs usando Claude.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "previews": "tsx scripts/build-previews.ts",
    "heygen:avatars": "tsx scripts/heygen-avatars.ts"
  },
  "keywords": [
    "claude",
    "anthropic",
    "pdf",
    "slides",
    "reveal.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "image-size": "^2.0.2",
    "playwright-core": "^1.62.0",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
